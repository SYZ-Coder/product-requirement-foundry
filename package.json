{
  "name": "product-requirement-foundry",
  "version": "0.1.1",
  "description": "Turn one-line product requests into history-compatible PRD and AI-ready OpenSpec handoff artifacts.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
